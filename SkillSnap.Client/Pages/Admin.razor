@page "/admin"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using SkillSnap.Client.Models
@using SkillSnap.Client.Services
@inject AuthService AuthService
@inject PortfolioUserService PortfolioUserService
@inject ProjectService ProjectService
@inject SkillService SkillService
@inject IJSRuntime JavaScript

<PageTitle>Admin | SkillSnap</PageTitle>

<main class="container py-4">
    <h1 class="mb-4">Admin CRUD</h1>

    @if (_isCheckingAccess || _isLoading)
    {
        <p role="status">Loading admin data...</p>
    }
    else if (!_isAdmin)
    {
        <div class="alert alert-warning" role="alert">
            You must be signed in as an administrator to manage portfolio data.
            <a href="login" class="alert-link">Log in</a>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">@_errorMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert alert-success" role="status">@_successMessage</div>
        }

        <section class="mb-5" aria-labelledby="profiles-heading">
            <h2 id="profiles-heading">Profiles</h2>
            <EditForm Model="_profileForm" OnValidSubmit="SaveProfileAsync" FormName="profile-form" class="card card-body mb-3">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="profile-name" class="form-label">Name</label>
                        <InputText id="profile-name" class="form-control" @bind-Value="_profileForm.Name" />
                        <ValidationMessage For="@(() => _profileForm.Name)" />
                    </div>
                    <div class="col-md-6">
                        <label for="profile-image" class="form-label">Profile image URL</label>
                        <InputText id="profile-image" class="form-control" @bind-Value="_profileForm.ProfileImageUrl" />
                        <ValidationMessage For="@(() => _profileForm.ProfileImageUrl)" />
                    </div>
                    <div class="col-12">
                        <label for="profile-bio" class="form-label">Bio</label>
                        <InputTextArea id="profile-bio" class="form-control" @bind-Value="_profileForm.Bio" />
                        <ValidationMessage For="@(() => _profileForm.Bio)" />
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button class="btn btn-primary" type="submit" disabled="@_isBusy">
                        @(_profileForm.Id == 0 ? "Add profile" : "Save profile")
                    </button>
                    @if (_profileForm.Id != 0)
                    {
                        <button class="btn btn-outline-secondary" type="button" @onclick="ResetProfileForm" disabled="@_isBusy">
                            Cancel edit
                        </button>
                    }
                </div>
            </EditForm>

            @if (_profiles.Count == 0)
            {
                <p class="text-muted">No profiles yet. Add one to associate projects and skills with it.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr><th>Name</th><th>Bio</th><th>Image URL</th><th>Actions</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var profile in _profiles)
                            {
                                <tr @key="profile.Id">
                                    <td>@profile.Name</td>
                                    <td>@profile.Bio</td>
                                    <td class="text-break">@profile.ProfileImageUrl</td>
                                    <td class="text-nowrap">
                                        <button class="btn btn-sm btn-outline-primary me-2" type="button"
                                                @onclick="() => EditProfile(profile)" disabled="@_isBusy">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger" type="button"
                                                @onclick="() => DeleteProfileAsync(profile)" disabled="@_isBusy">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="mb-5" aria-labelledby="projects-heading">
            <h2 id="projects-heading">Projects</h2>
            <EditForm Model="_projectForm" OnValidSubmit="SaveProjectAsync" FormName="project-form" class="card card-body mb-3">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="project-title" class="form-label">Title</label>
                        <InputText id="project-title" class="form-control" @bind-Value="_projectForm.Title" />
                        <ValidationMessage For="@(() => _projectForm.Title)" />
                    </div>
                    <div class="col-md-6">
                        <label for="project-profile" class="form-label">Profile</label>
                        <InputSelect id="project-profile" class="form-select" @bind-Value="_projectForm.PortfolioUserId" disabled="@(_profiles.Count == 0)">
                            @foreach (var profile in _profiles)
                            {
                                <option value="@profile.Id">@profile.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => _projectForm.PortfolioUserId)" />
                    </div>
                    <div class="col-12">
                        <label for="project-description" class="form-label">Description</label>
                        <InputTextArea id="project-description" class="form-control" @bind-Value="_projectForm.Description" />
                        <ValidationMessage For="@(() => _projectForm.Description)" />
                    </div>
                    <div class="col-md-8">
                        <label for="project-image" class="form-label">Image URL</label>
                        <InputText id="project-image" class="form-control" @bind-Value="_projectForm.ImageUrl" />
                        <ValidationMessage For="@(() => _projectForm.ImageUrl)" />
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button class="btn btn-primary" type="submit" disabled="@(_isBusy || _profiles.Count == 0)">
                        @(_projectForm.Id == 0 ? "Add project" : "Save project")
                    </button>
                    @if (_projectForm.Id != 0)
                    {
                        <button class="btn btn-outline-secondary" type="button" @onclick="ResetProjectForm" disabled="@_isBusy">
                            Cancel edit
                        </button>
                    }
                </div>
                @if (_profiles.Count == 0)
                {
                    <p class="text-muted mt-2 mb-0">Create a profile before adding a project.</p>
                }
            </EditForm>

            @if (_projects.Count == 0)
            {
                <p class="text-muted">No projects yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr><th>Title</th><th>Profile</th><th>Description</th><th>Actions</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var project in _projects)
                            {
                                <tr @key="project.Id">
                                    <td>@project.Title</td>
                                    <td>@ProfileName(project.PortfolioUserId)</td>
                                    <td>@project.Description</td>
                                    <td class="text-nowrap">
                                        <button class="btn btn-sm btn-outline-primary me-2" type="button"
                                                @onclick="() => EditProject(project)" disabled="@_isBusy">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger" type="button"
                                                @onclick="() => DeleteProjectAsync(project)" disabled="@_isBusy">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="mb-5" aria-labelledby="skills-heading">
            <h2 id="skills-heading">Skills</h2>
            <EditForm Model="_skillForm" OnValidSubmit="SaveSkillAsync" FormName="skill-form" class="card card-body mb-3">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="skill-name" class="form-label">Name</label>
                        <InputText id="skill-name" class="form-control" @bind-Value="_skillForm.Name" />
                        <ValidationMessage For="@(() => _skillForm.Name)" />
                    </div>
                    <div class="col-md-4">
                        <label for="skill-level" class="form-label">Level</label>
                        <InputText id="skill-level" class="form-control" @bind-Value="_skillForm.Level" />
                        <ValidationMessage For="@(() => _skillForm.Level)" />
                    </div>
                    <div class="col-md-4">
                        <label for="skill-profile" class="form-label">Profile</label>
                        <InputSelect id="skill-profile" class="form-select" @bind-Value="_skillForm.PortfolioUserId" disabled="@(_profiles.Count == 0)">
                            @foreach (var profile in _profiles)
                            {
                                <option value="@profile.Id">@profile.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => _skillForm.PortfolioUserId)" />
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button class="btn btn-primary" type="submit" disabled="@(_isBusy || _profiles.Count == 0)">
                        @(_skillForm.Id == 0 ? "Add skill" : "Save skill")
                    </button>
                    @if (_skillForm.Id != 0)
                    {
                        <button class="btn btn-outline-secondary" type="button" @onclick="ResetSkillForm" disabled="@_isBusy">
                            Cancel edit
                        </button>
                    }
                </div>
                @if (_profiles.Count == 0)
                {
                    <p class="text-muted mt-2 mb-0">Create a profile before adding a skill.</p>
                }
            </EditForm>

            @if (_skills.Count == 0)
            {
                <p class="text-muted">No skills yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr><th>Name</th><th>Level</th><th>Profile</th><th>Actions</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var skill in _skills)
                            {
                                <tr @key="skill.Id">
                                    <td>@skill.Name</td>
                                    <td>@skill.Level</td>
                                    <td>@ProfileName(skill.PortfolioUserId)</td>
                                    <td class="text-nowrap">
                                        <button class="btn btn-sm btn-outline-primary me-2" type="button"
                                                @onclick="() => EditSkill(skill)" disabled="@_isBusy">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger" type="button"
                                                @onclick="() => DeleteSkillAsync(skill)" disabled="@_isBusy">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</main>

@code {
    private List<PortfolioUser> _profiles = [];
    private List<Project> _projects = [];
    private List<Skill> _skills = [];
    private PortfolioUser _profileForm = new();
    private Project _projectForm = new();
    private Skill _skillForm = new();
    private bool _isCheckingAccess = true;
    private bool _isLoading;
    private bool _isAdmin;
    private bool _isBusy;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await AuthService.InitializeAsync();
            _isAdmin = AuthService.IsAuthenticated &&
                string.Equals(AuthService.CurrentUser.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value,
                    "Admin", StringComparison.OrdinalIgnoreCase);
        }
        finally
        {
            _isCheckingAccess = false;
        }

        if (!_isAdmin)
        {
            return;
        }

        _isLoading = true;
        try
        {
            await LoadDataAsync();
        }
        catch (HttpRequestException exception)
        {
            SetRequestError(exception);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadDataAsync()
    {
        var profilesTask = PortfolioUserService.GetProfilesAsync();
        var projectsTask = ProjectService.GetProjectsAsync();
        var skillsTask = SkillService.GetSkillsAsync();
        await Task.WhenAll(profilesTask, projectsTask, skillsTask);

        _profiles = await profilesTask;
        _projects = await projectsTask;
        _skills = await skillsTask;
        ResetProfileForm();
        ResetProjectForm();
        ResetSkillForm();
    }

    private void EditProfile(PortfolioUser profile)
    {
        _profileForm = new()
        {
            Id = profile.Id,
            Name = profile.Name,
            Bio = profile.Bio,
            ProfileImageUrl = profile.ProfileImageUrl
        };
        ClearMessages();
    }

    private void EditProject(Project project)
    {
        _projectForm = new()
        {
            Id = project.Id,
            Title = project.Title,
            Description = project.Description,
            ImageUrl = project.ImageUrl,
            PortfolioUserId = project.PortfolioUserId
        };
        ClearMessages();
    }

    private void EditSkill(Skill skill)
    {
        _skillForm = new()
        {
            Id = skill.Id,
            Name = skill.Name,
            Level = skill.Level,
            PortfolioUserId = skill.PortfolioUserId
        };
        ClearMessages();
    }

    private async Task SaveProfileAsync()
    {
        await ExecuteRequestAsync(async () =>
        {
            var saved = _profileForm.Id == 0
                ? await PortfolioUserService.AddProfileAsync(_profileForm)
                : await PortfolioUserService.UpdateProfileAsync(_profileForm);
            if (saved is null)
            {
                _errorMessage = "The profile was not returned by the API.";
                return false;
            }

            await LoadDataAsync();
            return true;
        }, _profileForm.Id == 0 ? "Profile added." : "Profile updated.");
    }

    private async Task SaveProjectAsync()
    {
        await ExecuteRequestAsync(async () =>
        {
            var saved = _projectForm.Id == 0
                ? await ProjectService.AddProjectAsync(_projectForm)
                : await ProjectService.UpdateProjectAsync(_projectForm);
            if (saved is null)
            {
                _errorMessage = "The project was not returned by the API.";
                return false;
            }

            await LoadDataAsync();
            return true;
        }, _projectForm.Id == 0 ? "Project added." : "Project updated.");
    }

    private async Task SaveSkillAsync()
    {
        await ExecuteRequestAsync(async () =>
        {
            var saved = _skillForm.Id == 0
                ? await SkillService.AddSkillAsync(_skillForm)
                : await SkillService.UpdateSkillAsync(_skillForm);
            if (saved is null)
            {
                _errorMessage = "The skill was not returned by the API.";
                return false;
            }

            await LoadDataAsync();
            return true;
        }, _skillForm.Id == 0 ? "Skill added." : "Skill updated.");
    }

    private async Task DeleteProfileAsync(PortfolioUser profile)
    {
        var confirmed = await JavaScript.InvokeAsync<bool>("confirm",
            $"Delete {profile.Name}? This will also delete the profile's projects and skills.");
        if (!confirmed)
        {
            return;
        }

        await ExecuteRequestAsync(async () =>
        {
            await PortfolioUserService.DeleteProfileAsync(profile.Id);
            await LoadDataAsync();
            return true;
        }, "Profile and its projects and skills deleted.");
    }

    private async Task DeleteProjectAsync(Project project)
    {
        if (!await JavaScript.InvokeAsync<bool>("confirm", $"Delete project '{project.Title}'?"))
        {
            return;
        }

        await ExecuteRequestAsync(async () =>
        {
            await ProjectService.DeleteProjectAsync(project.Id);
            await LoadDataAsync();
            return true;
        }, "Project deleted.");
    }

    private async Task DeleteSkillAsync(Skill skill)
    {
        if (!await JavaScript.InvokeAsync<bool>("confirm", $"Delete skill '{skill.Name}'?"))
        {
            return;
        }

        await ExecuteRequestAsync(async () =>
        {
            await SkillService.DeleteSkillAsync(skill.Id);
            await LoadDataAsync();
            return true;
        }, "Skill deleted.");
    }

    private async Task ExecuteRequestAsync(Func<Task<bool>> request, string successMessage)
    {
        _isBusy = true;
        ClearMessages();
        try
        {
            if (await request())
            {
                _successMessage = successMessage;
            }
        }
        catch (HttpRequestException exception)
        {
            SetRequestError(exception);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private string ProfileName(int profileId)
    {
        return _profiles.FirstOrDefault(profile => profile.Id == profileId)?.Name ?? $"Profile #{profileId}";
    }

    private void ResetProfileForm() => _profileForm = new();

    private void ResetProjectForm() => _projectForm = new()
    {
        PortfolioUserId = _profiles.FirstOrDefault()?.Id ?? 0
    };

    private void ResetSkillForm() => _skillForm = new()
    {
        PortfolioUserId = _profiles.FirstOrDefault()?.Id ?? 0
    };

    private void ClearMessages()
    {
        _errorMessage = null;
        _successMessage = null;
    }

    private void SetRequestError(HttpRequestException exception)
    {
        _errorMessage = exception.StatusCode is null
            ? $"Request failed: {exception.Message}"
            : $"Request failed with HTTP {(int)exception.StatusCode}: {exception.StatusCode}.";
    }
}
