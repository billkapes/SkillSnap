@page "/register"
@rendermode InteractiveWebAssembly
@using System.ComponentModel.DataAnnotations
@using SkillSnap.Client.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Create account | SkillSnap</PageTitle>

<main class="auth-page">
    <section class="auth-copy">
        <span class="eyebrow">START WITH YOUR STORY</span>
        <h1>Make your skills visible.</h1>
        <p>Create an account and start shaping a portfolio that grows with every project.</p>
    </section>

    <section class="auth-card">
        <p class="text-muted mb-4">Use an email and a password of at least 12 characters.</p>
        <EditForm Model="_form" OnValidSubmit="SubmitAsync" FormName="register">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label for="register-email" class="form-label">Email</label>
                <InputText id="register-email" class="form-control" type="email" autocomplete="email" @bind-Value="_form.Email" />
                <ValidationMessage For="@(() => _form.Email)" />
            </div>

            <div class="mb-3">
                <label for="register-password" class="form-label">Password</label>
                <InputText id="register-password" class="form-control" type="password" autocomplete="new-password" @bind-Value="_form.Password" />
                <ValidationMessage For="@(() => _form.Password)" />
            </div>

            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <p class="text-success" role="status">@_statusMessage</p>
            }
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <p class="text-danger" role="alert">@_errorMessage</p>
            }

            <button class="btn btn-primary w-100" type="submit" disabled="@_isSubmitting">
                @(_isSubmitting ? "Creating account..." : "Create account")
            </button>
        </EditForm>

        <p class="auth-switch">Already registered? <a href="login">Log in</a>.</p>
    </section>
</main>

@code {
    private readonly RegisterForm _form = new();
    private string? _statusMessage;
    private string? _errorMessage;
    private bool _isSubmitting;

    private async Task SubmitAsync()
    {
        _isSubmitting = true;
        _statusMessage = null;
        _errorMessage = null;
        try
        {
            var result = await AuthService.RegisterAsync(_form.Email, _form.Password);
            if (result.Succeeded)
            {
                _statusMessage = "If an account can be created with this email, it is ready to sign in.";
            }
            else
            {
                _errorMessage = result.ErrorMessage;
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class RegisterForm
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        [MinLength(12)]
        public string Password { get; set; } = string.Empty;
    }
}