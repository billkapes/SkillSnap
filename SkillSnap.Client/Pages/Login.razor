@page "/login"
@rendermode InteractiveWebAssembly
@using System.ComponentModel.DataAnnotations
@using SkillSnap.Client.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Log in | SkillSnap</PageTitle>

<h1>Log in</h1>
<p>Sign in to your SkillSnap account.</p>

<EditForm Model="_form" OnValidSubmit="SubmitAsync" FormName="login">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="login-email" class="form-label">Email</label>
        <InputText id="login-email" class="form-control" type="email" autocomplete="username" @bind-Value="_form.Email" />
        <ValidationMessage For="@(() => _form.Email)" />
    </div>

    <div class="mb-3">
        <label for="login-password" class="form-label">Password</label>
        <InputText id="login-password" class="form-control" type="password" autocomplete="current-password" @bind-Value="_form.Password" />
        <ValidationMessage For="@(() => _form.Password)" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <p class="text-danger" role="alert">@_errorMessage</p>
    }

    <button class="btn btn-primary" type="submit" disabled="@_isSubmitting">
        @(_isSubmitting ? "Signing in..." : "Log in")
    </button>
</EditForm>

<p class="mt-3">New to SkillSnap? <a href="register">Create an account</a>.</p>

@code {
    private readonly LoginForm _form = new();
    private string? _errorMessage;
    private bool _isSubmitting;

    private async Task SubmitAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;
        try
        {
            var result = await AuthService.LoginAsync(_form.Email, _form.Password);
            if (result.Succeeded)
            {
                Navigation.NavigateTo("/");
                return;
            }

            _errorMessage = result.ErrorMessage;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class LoginForm
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}