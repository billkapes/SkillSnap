@using SkillSnap.Client.Models
@using SkillSnap.Client.Services
<section class="project-list">
    <h2 class="h4">Projects</h2>

    <div class="list-group">
        @foreach (var project in projects)
        {
            <article class="list-group-item">
                <h3 class="h5 mb-1">@project.Title</h3>
                <p class="mb-0 text-muted">@project.Description</p>
            </article>
        }
    </div>
</section>

@inject ProjectService ProjectService
@code {
    private List<Project> projects = [];

    protected override async Task OnInitializedAsync()
    {
        projects = await ProjectService.GetProjectsAsync();
    }

    @* private readonly List<ProjectPlaceholder> Projects =
    [
        new("SkillSnap", "A portfolio for sharing skills and projects."),
        new("TaskFlow", "A lightweight planner for focused teams."),
        new("GreenCart", "A simple shopping experience for local produce.")
    ];

    private sealed record ProjectPlaceholder(string Name, string Description); *@
}