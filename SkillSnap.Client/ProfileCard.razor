@using SkillSnap.Client.Models

<section class="profile-hero" aria-label="Profile">
    @if (Profile is not null)
    {
        <div class="profile-identity">
            @if (!string.IsNullOrWhiteSpace(Profile.ProfileImageUrl) && !_imageFailed)
            {
                <img class="profile-avatar"
                     src="@Profile.ProfileImageUrl"
                     alt="@($"Profile picture of {Profile.Name}")"
                     @onerror="HandleImageError"
                     width="96"
                     height="96" />
            }
            else
            {
                <span class="profile-avatar-fallback" aria-hidden="true">@Initials</span>
            }
            <div>
                <p class="profile-kicker">The person behind the projects</p>
                <h2 class="profile-name">@Profile.Name</h2>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Profile.Bio))
        {
            <p class="profile-bio">@Profile.Bio</p>
        }
    }
    else
    {
        <div class="profile-identity">
            <span class="profile-avatar-fallback" aria-hidden="true">S</span>
            <div>
                <p class="profile-kicker">Your portfolio starts here</p>
                <h2 class="profile-name">Make room for your next idea.</h2>
            </div>
        </div>
        <p class="profile-bio">Add a profile in the admin area to introduce yourself and make this portfolio yours.</p>
    }
</section>

@code {
    private string? _imageUrl;
    private bool _imageFailed;

    [Parameter]
    public PortfolioUser? Profile { get; set; }

    protected override void OnParametersSet()
    {
        if (_imageUrl != Profile?.ProfileImageUrl)
        {
            _imageUrl = Profile?.ProfileImageUrl;
            _imageFailed = false;
        }
    }

    private void HandleImageError()
    {
        _imageFailed = true;
    }

    private string Initials
    {
        get
        {
            var initials = string.Join("", (Profile?.Name ?? string.Empty)
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(part => char.ToUpperInvariant(part[0])));
            return string.IsNullOrEmpty(initials) ? "S" : initials;
        }
    }
}