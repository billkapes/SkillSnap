@using SkillSnap.Client.Models
@using SkillSnap.Client.Services

<section class="skills-panel" aria-labelledby="skills-title">
    <header class="section-heading">
        <div>
            <span class="section-kicker">TOOLS OF THE TRADE</span>
            <h2 id="skills-title">Skills</h2>
        </div>
        <span class="section-count">@Skills.Count.ToString("00") / SKILLS</span>
    </header>

    @if (Skills.Count == 0)
    {
        <p class="empty-state mb-0">Skills will appear here as you add them to your portfolio.</p>
    }
    else
    {
        <ul class="skill-cloud">
            @foreach (var skill in Skills)
            {
                <li class="skill-chip">@skill.Name</li>
            }
        </ul>
    }
</section>

@inject SkillService SkillService
@code {
    private List<Skill> Skills = [];

    protected override async Task OnInitializedAsync()
    {
        Skills = await SkillService.GetSkillsAsync();
    }
}
