@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <div class="workspace">
        <header class="workspace-bar">
            <span class="workspace-label">PORTFOLIO / <strong>YOUR SPACE</strong></span>
            <span class="workspace-status"><span class="status-dot"></span> Made to grow with you</span>
        </header>

        <main class="workspace-content">
            @Body
        </main>

        <footer class="workspace-footer">
            <span>SkillSnap</span>
            <span>Built around what you can do.</span>
        </footer>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <span>An unexpected error occurred.</span>
    <a href="." class="reload">Reload the page</a>
    <button type="button" class="dismiss" aria-label="Dismiss error">×</button>
</div>
