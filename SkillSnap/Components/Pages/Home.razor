@page "/"
@using SkillSnap.Client.Models
@using SkillSnap.Client.Services
@inject PortfolioUserService PortfolioUserService

<PageTitle>SkillSnap Preview</PageTitle>

<div class="container py-4">
	<h1 class="mb-4">SkillSnap Preview</h1>

	<div class="row g-4">
		<div class="col-12 col-lg-4">
			<ProfileCard Profile="profile" />
		</div>
		<div class="col-12 col-lg-8">
			<ProjectList />
		</div>
		<div class="col-12">
			<SkillTags @rendermode="InteractiveWebAssembly" />
		</div>
	</div>

	@code {
		private PortfolioUser? profile;

		protected override async Task OnInitializedAsync()
		{
			profile = (await PortfolioUserService.GetProfilesAsync()).FirstOrDefault();
		}
	}
</div>
