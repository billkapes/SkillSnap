@page "/"
@using SkillSnap.Client.Models
@using SkillSnap.Client.Services
@inject PortfolioUserService PortfolioUserService

<PageTitle>SkillSnap | Portfolio</PageTitle>

<div class="portfolio-home">
    <header class="portfolio-heading">
        <div>
            <span class="eyebrow">A little about what I do</span>
            <h1>Good work deserves a place to land.</h1>
            <p>A snapshot of the things I make, the skills I use, and the ideas I’m working on.</p>
        </div>
        <span class="portfolio-index">PORTFOLIO&nbsp; · &nbsp;001</span>
    </header>

    <ProfileCard Profile="profile" @rendermode="InteractiveWebAssembly" />
    <ProjectList @rendermode="InteractiveWebAssembly" />
    <SkillTags @rendermode="InteractiveWebAssembly" />
</div>

@code {
    private PortfolioUser? profile;

    protected override async Task OnInitializedAsync()
    {
        profile = (await PortfolioUserService.GetProfilesAsync()).FirstOrDefault();
    }
}
